---
import '../styles/global.css';
import ImagePreloader from '../components/ImagePreloader.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from "astro:transitions";
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">
        <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#0079ff">
        <meta name="msapplication-TileColor" content="#0079ff">
        <meta name="theme-color" content="#0045A5">
        <meta property="og:title" content="Madekuji-san!" />
        <meta property="og:description" content="Otaku for others. Your friendly neighborhood tech support VTuber!" />
        <meta property="og:image" content="https://mdkj.dev/img/social.png">
        <meta property="og:url" content="https://mdkj.dev" />
        <meta name="twitter:title" content="Madekuji-san!" >
        <meta name="twitter:description" content="Otaku for others. Your friendly neighborhood tech support VTuber!" />
        <meta name="twitter:image" content="https://mdkj.dev/img/social.png" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@Madekuji_san" />
        <meta name="twitter:creator" content="@Madekuji_san" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Madekuji-san!</title>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_forward_ios,home,info,work" />
        <ClientRouter />
    </head>
    <body>
        <ImagePreloader></ImagePreloader>
        <div id="root">
            <Navbar />
            <div id="bodyDiv">
                <slot />
            </div>
            <img id="bg_logo" src="/img/bg_logo.svg" alt="bg_logo"/>
            <img id="bg" src="/img/bg_blank.webp" alt="BG"/>
            <Footer />
        </div>
    </body>
</html>